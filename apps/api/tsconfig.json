{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": "dist",
    "noEmitOnError": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "src/**/*.ts",
    "../../packages/contracts/**/*.ts"
  ]
}
