# Airlock runtime configuration example.
# These are shell environment variables, not a dotenv file. The service scripts do not
# source this file automatically. Keep real values outside the repository.
# No wallet seed, identity, approval MAC key, session, or operator credential belongs here.

# Optional: the lifecycle scripts derive the repository root from their own location.
# AIRLOCK_REPO_DIR=/srv/airlock

# Patched gate binary. Build it with scripts/build-gate.sh or point at an existing build.
AIRLOCK_DEVTOOL_BIN=/home/airlock/airlock-build/zcash-devtool/target/release/zcash-devtool
AIRLOCK_NODE_BIN=/usr/bin/node
AIRLOCK_BWRAP_BIN=/usr/bin/bwrap
AIRLOCK_RUNTIME_USER=airlock

# Private runtime state. These paths must stay outside this repository.
AIRLOCK_WALLET_ROOT=/home/airlock/airlock-state
AIRLOCK_SENDER_WALLET=/home/airlock/airlock-state/sender
AIRLOCK_RECIPIENT_WALLET=/home/airlock/airlock-state/recipient
AIRLOCK_IDENTITY_FILE=/home/airlock/airlock-state/sender-age.txt
AIRLOCK_RECIPIENT_UA_FILE=/home/airlock/airlock-state/recipient.ua
AIRLOCK_SENDER_UA_FILE=/home/airlock/airlock-state/sender.ua
AIRLOCK_ALT_RECIPIENT_UA_FILE=/home/airlock/airlock-state/alt-recipient.ua
AIRLOCK_GATE_HOME=/home/airlock/.airlock-gate
AIRLOCK_RUN_DIR=/home/airlock/airlock-run
AIRLOCK_WORKER_STATE=/home/airlock/airlock-worker
AIRLOCK_WORKER_SPOOL=/home/airlock/airlock-worker-spool
AIRLOCK_API_STATE=/home/airlock/airlock-api-state
AIRLOCK_LOG_DIR=/home/airlock/airlock-logs

# Public API. Use HTTPS and AIRLOCK_COOKIE_SECURE=1 behind a real reverse proxy.
AIRLOCK_API_HOST=127.0.0.1
AIRLOCK_API_PORT=8787
AIRLOCK_PUBLIC_ORIGIN=http://127.0.0.1:8787
AIRLOCK_COOKIE_SECURE=0

# Operator provisioning inputs for provision-demo-clean.sh.
AIRLOCK_SET_ID=set-local-demo
AIRLOCK_MATCH_ID=local-match
AIRLOCK_RECIPIENT_ID=local-recipient
AIRLOCK_MEMO_ID=local-memo
AIRLOCK_APPROVAL_MAX_FEE=10000
AIRLOCK_APPROVAL_EXPIRES_IN=604800
AIRLOCK_PROVISION_APPEND=0
